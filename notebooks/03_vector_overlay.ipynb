    "# Week 3: Load and analyze vector data\n",
    "import geopandas as gpd\n",
    "from shapely.geometry import Point, Polygon, box\n",
    "import numpy as np\n",
    "import os\n",
    "\n",
    "wd = '/home/recursivex/my_projects/my_career/2026_roadmap_fully_funded_opportunities/hydrogen_storage_site_selection'\n",
    "os.chdir(wd)\n",
    "\n",
    "# Load shapefiles from data/raw\n",
    "raw_dir = 'data/raw'\n",
    "\n",
    "# Load geology basins\n",
    "basins_path = os.path.join(raw_dir, 'usgs_basins.shp')\n",
    "basins = gpd.read_file(basins_path)\n",
    "\n",
    "# Load end-users (ports/industrial centers)\n",
    "users_path = os.path.join(raw_dir, 'end_users.shp')\n",
    "users = gpd.read_file(users_path)\n",
    "\n",
    "print('=== USGS Basins ===')\n",
    "print(f'Number of basins: {len(basins)}')\n",
    f'Columns: {list(basins.columns)}')\n",
    "\n",
    "print('\\n=== End Users ===')\n",
    "print(f'Number of users: {len(users)}')\n",
    f'Columns: {list(users.columns)}')\n",
    "\n",
    "# Set CRS if not already set\n",
    "if basins.crs is None:\n",
    "    basins = basins.set_crs(epsg=4326)\n",
    "if users.crs is None:\n",
    "    users = users.set_crs(epsg=4326)\n",
    "\n",
    "print(f'\\nBasins CRS: {basins.crs}')\n",
    "print(f'Users CRS: {users.crs}')"
   ]
